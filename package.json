{
  "name": "despia-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "compile": "node scripts/port-legacy.mjs && node scripts/migrate-map.mjs && node scripts/compile.mjs && node site/web-apps-packages.mjs && node site/build.mjs && node site/dsx-compile.mjs && node scripts/legacy-archive.mjs",
    "build": "npm run compile && dsx build && node scripts/assemble.mjs",
    "dev": "npm run compile && dsx dev",
    "lint": "npm run compile && dsx lint --strict",
    "redirects": "node scripts/redirects.mjs",
    "parity": "node scripts/setup-parity.mjs",
    "bench": "node --experimental-strip-types --no-warnings scripts/bench-search.mjs",
    "integrations": "node scripts/sync-integrations.mjs",
    "hub": "node scripts/sync-hub.mjs"
  },
  "dependencies": {
    "@despia-native/compiler": "0.1.0",
    "@despia-native/dom": "0.1.0",
    "@despia-native/kernel": "0.1.0",
    "@despia-native/server": "0.1.0"
  },
  "devDependencies": {
    "@despia-native/cli": "0.1.0",
    "wrangler": "^4.123.0"
  }
}
